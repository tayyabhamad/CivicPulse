server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Docker's embedded DNS resolves service names at request time.  Keeping
    # this dynamic means the UI does not fail to start if the API container is
    # recreated during a deployment.
    resolver 127.0.0.11 ipv6=off valid=10s;
    set $api_upstream http://${API_UPSTREAM};

    location /api/ {
        # ``proxy_pass`` with a variable does not append the unmatched URI
        # suffix automatically, so explicitly forward the original API path.
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }
}
